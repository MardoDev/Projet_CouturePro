# Copier en .env — ne jamais committer .env (voir .gitignore).

# Serveur
PORT=4000
NODE_ENV=development

# Phase 2 — base de données (Prisma/PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5434/couture_dynamic_pro

# Phase 2/7 — cache, sessions, Socket.IO
# Port 6380 : voir docker-compose.yml (6379 déjà pris par un autre projet local)
REDIS_URL=redis://localhost:6380

# Phase 3 — auth/RBAC (A VALIDER : politique de session/MFA, voir GUIDE-VIBE-CODING.md)
JWT_SECRET=change-me
SESSION_SECRET=change-me

# Phase 7 — médias
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 7 — paiements (devise = XAF, résolue ; A VALIDER : taxes/comptes prod, voir GUIDE-VIBE-CODING.md)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
WEB_ORIGIN=http://localhost:3000
